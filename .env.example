# Copy to .env and replace the placeholders before starting the API.
DATABASE_URL=postgresql+psycopg://donor_app:change-me@localhost:5432/donor_management
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8443

# Razorpay test-mode credentials. Leave blank to disable checkout; successful
# payments are never simulated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
